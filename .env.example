# EchoServe V0.2.0 — 环境变量模板
# 复制为 .env 后按需修改

# ─── 模型配置（RTX 4090 48GB）──────────────
MODEL_PATH=./models/qwen3-14b-q4
MODEL_NAME=qwen3-14b-q4
MODEL_MAX_CTX=32768
MODEL_GPU_MEM_UTIL=0.90

# ─── vLLM 推理服务 ────────────────────────────
VLLM_HOST=http://vllm:8000
VLLM_API_KEY=
VLLM_MAX_MODEL_LEN=32768
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_PREFIX_CACHE=true

# ─── Chroma 向量数据库 ────────────────────────
CHROMA_HOST=http://chroma:8000
CHROMA_COLLECTION=echoseve_kb
CHROMA_PERSIST_DIR=./data/chroma

# ─── Embedding 模型 ────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# ─── 检索配置（含重排序）──────────────────────
RETRIEVAL_TOP_K=10
RRF_K=60
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6

# P1 — Cross-Encoder 重排序
RERANK_ENABLED=true
RERANK_TIER=standard          # light / standard / high_precision
RERANK_DEVICE=cpu             # CPU 足够，不占 GPU
RERANK_MAX_LEN=512
RERANK_TOP_N=20
RERANK_FINAL_K=5
RERANK_THRESHOLD=0.0

# ─── API 配置 ───────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── 安全配置 ──────────────────────────────────
# 生成随机密钥: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=480
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30

# ─── 日志配置 ──────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./data/logs/echoseve.log

# ─── P1 — 监控配置 ─────────────────────────────
MONITORING_ENABLED=true
METRICS_PORT=9090
METRICS_INTERVAL=15
GRAFANA_DASHBOARD=true

# ─── P1 — 模型进化引擎配置 ────────────────────
EVOLVE_ENABLED=true
TRAIN_DATA_PATH=./data/training/train.jsonl
TEST_DATA_PATH=./data/training/test_set.jsonl
EVAL_REPORT_DIR=./data/training/reports
ADAPTERS_DIR=./models/adapters
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
TRAIN_EPOCHS=3
TRAIN_BATCH_SIZE=2
TRAIN_LR=2e-4
VARIANTS_PER_Q=3
GENERIC_RATIO=0.15

# ─── P1 — 备份配置 ──────────────────────────────
BACKUP_ENABLED=true
BACKUP_DIR=./data/backups
BACKUP_RETENTION=30
BACKUP_SCHEDULE=0 3 * * *
BACKUP_MODELS=false

# ─── 企业微信（P0 已有）───────────────────────
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=
WECHAT_TOKEN=
WECHAT_AES_KEY=

# ─── 数据库密码 ────────────────────────────────
DB_PASSWORD=echoseve_secure_2026

# ─── V0.1.6 — Redis 配置（会话持久化）──────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SESSION_TTL=1800
REDIS_KEY_PREFIX=echoseve:session:

# ─── V0.1.7 — PostgreSQL 配置（用户/API Key 持久化）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=echoseve
POSTGRES_USER=echoseve
POSTGRES_PASSWORD=echoseve_secure_2026
PG_POOL_MIN=2
PG_POOL_MAX=10
