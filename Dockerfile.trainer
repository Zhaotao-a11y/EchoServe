# EchoServe P1 — LoRA 训练容器
# 使用：docker compose --profile training up

FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

# 环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3-venv \
    git \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 创建虚拟环境
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 升级 pip
RUN pip install --upgrade pip setuptools wheel

# 安装 Python 依赖
RUN pip install \
    torch==2.4.0 \
    torchvision==0.19.0 \
    --index-url https://download.pytorch.org/whl/cu121

RUN pip install \
    transformers==4.44.0 \
    peft==0.12.0 \
    datasets==2.20.0 \
    accelerate==0.33.0 \
    sentencepiece==0.2.0 \
    protobuf==4.25.0 \
    numpy==1.26.0 \
    scikit-learn==1.5.0 \
    pandas==2.2.0 \
    tensorboard==2.17.0

# 安装 Deepspeed（可选，用于全参数微调）
RUN pip install deepspeed==0.14.0

# 创建工作目录
WORKDIR /app

# 复制训练脚本
COPY scripts/train_lora.py /app/train_lora.py
COPY scripts/train_full.py /app/train_full.py
COPY plugins/evolve/data_builder.py /app/data_builder.py

# 默认命令：运行 LoRA 训练
CMD ["python", "/app/train_lora.py"]
